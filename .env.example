# VIBRA Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub

# App URL
VITE_APP_URL=https://vibra.ng

# OPay API (get from OPay dashboard)
VITE_OPAY_MERCHANT_ID=your_merchant_id_here
VITE_OPAY_SECRET_KEY=your_secret_key_here

# Firebase (if using Firebase backend)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# WhatsApp (public - safe to show)
VITE_WHATSAPP_NUMBER=07032977572

# LabelReach Bank Details (public - safe to show)
VITE_LABELREACH_BANK=O Pay
VITE_LABELREACH_ACCOUNT=611-049-9938
VITE_LABELREACH_NAME=LABELREACH ADVERTISING LTD